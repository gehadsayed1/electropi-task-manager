    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "^10.2.0",
    "happy-dom": "^18.0.1",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.11",
